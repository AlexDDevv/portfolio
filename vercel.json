{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://alexisdelporte.dev/parcours",
      "statusCode": 301
    },
    {
      "source": "/cv_alexis_delporte_fr.pdf",
      "destination": "https://alexisdelporte.dev/cv/alexis-delporte-fr.pdf",
      "statusCode": 301
    },
    {
      "source": "/cv_alexis_delporte_en.pdf",
      "destination": "https://alexisdelporte.dev/cv/alexis-delporte-en.pdf",
      "statusCode": 301
    },
    {
      "source": "/projets/:slug(nuit-d-encre|grindrise){/}?",
      "destination": "https://alexisdelporte.dev/projets/:slug",
      "statusCode": 301
    },
    {
      "source": "/en/projects/:slug(nuit-d-encre|grindrise){/}?",
      "destination": "https://alexisdelporte.dev/en/projects/:slug",
      "statusCode": 301
    },
    {
      "source": "/en{/}?",
      "destination": "https://alexisdelporte.dev/en/profile",
      "statusCode": 301
    },
    {
      "source": "/en/:path*",
      "destination": "https://alexisdelporte.dev/en/profile",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://alexisdelporte.dev/parcours",
      "statusCode": 301
    }
  ]
}
